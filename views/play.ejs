// Put your 4 image paths here, in the order they should appear. They should
// live under /public so Express serves them — e.g. drop the files in
// public/images/prologue/ and reference them as shown below.
const PROLOGUE_IMAGES=[
  '/images/prologue/1.jpg',
  '/images/prologue/2.jpg',
  '/images/prologue/3.jpg',
  '/images/prologue/4.jpg'
];

let prologueIndex=0;
function showProloguePanel(i){
  document.getElementById('prologueImg').src=PROLOGUE_IMAGES[i];
  const dots=document.getElementById('prologueDots');
  dots.innerHTML='';
  PROLOGUE_IMAGES.forEach((_,idx)=>{
    const d=document.createElement('span');
    if(idx===i)d.className='active';
    dots.appendChild(d);
  });
  document.getElementById('prologueNextBtn').textContent=(i===PROLOGUE_IMAGES.length-1)?'BEGIN':'NEXT';
}
function runPrologue(onDone){
  prologueIndex=0;
  const box=document.getElementById('prologue');
  showProloguePanel(prologueIndex);
  box.classList.add('on');
  document.getElementById('prologueNextBtn').onclick=()=>{
    prologueIndex++;
    if(prologueIndex>=PROLOGUE_IMAGES.length){
      box.classList.remove('on');
      onDone();
      return;
    }
    showProloguePanel(prologueIndex);
  };
}


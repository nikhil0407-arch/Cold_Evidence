// ════ ENGINE ════
const DEBUG=false;  // set true to see floor bounds / obstacle boxes / door points
const canvas=document.getElementById('game'), ctx=canvas.getContext('2d');
const keys=new Set(), vkeys=new Set();
let raf=null, cur=null, transitioning=false, clock=0;
const P={x:485,y:520,dir:'up',moving:false,frame:0,ftick:0};
const CFG={speed:3.4, animFps:9, doorHold:3.0, armGrace:0.55, autoWalkOpen:0.62};

function scene(){ return SCENES[cur]; }
function edgeL(s,y){ const t=clamp((y-s.floorTop)/(s.floorBot-s.floorTop),0,1); return lerp(s.backL,s.frontL,t); }
function edgeR(s,y){ const t=clamp((y-s.floorTop)/(s.floorBot-s.floorTop),0,1); return lerp(s.backR,s.frontR,t); }
function clamp(v,a,b){ return v<a?a:v>b?b:v; }
function lerp(a,b,t){ return a+(b-a)*t; }

// feet half-width: both feet must stay off walls/objects (≈ "1mm away")
const FOOT=17;
function collides(s,x,y){
  if(y<s.floorTop||y>s.floorBot) return true;
  if(x-FOOT<edgeL(s,y)+6||x+FOOT>edgeR(s,y)-6) return true;
  for(const o of s.obstacles)
    if(x+FOOT>o.x0-2 && x-FOOT<o.x1+2 && y>o.y0-2 && y<o.y1+2) return true;
  return false;
}

function enterScene(key,spawn,fromRoom){
  cur=key; const s=scene();
  s.doors.forEach(d=>{ d.open=false; d.pending=false; d.hold=0; }); s.openDoor=null;
  // arriving in the hall: swing open the door of the room we just left, for 3s
  if(key==='hall' && fromRoom){
    const d=s.doors.find(dd=>dd.target===fromRoom);
    if(d){ d.open=true; d.hold=CFG.doorHold; s.openDoor=d; }
  }
  Object.assign(P,{x:spawn.x,y:spawn.y,dir:spawn.dir,moving:false,frame:0,ftick:0});
  document.getElementById('sceneLbl').textContent=s.label;
  updateDoorBtn(); updateActBtn();
}

// nearest interactive door within reach (open or closed)
function nearDoor(){ const s=scene(); let best=null,bd=1e9;
  for(const d of s.doors){ if(!d.interactive) continue;
    const dist=Math.hypot(P.x-d.tx, P.y-d.ty);
    if(dist<110 && dist<bd){ bd=dist; best=d; } }
  return best;
}
// press E / button: swing the door open, then auto-transport through it
function openCurrentDoor(){ if(transitioning) return;
  const d=nearDoor(); if(!d||d.pending) return;
  d.pending=true; d.open=true; d.hold=0; scene().openDoor=d;
  updateDoorBtn();
  setTimeout(()=>{ d.pending=false; doTransition(d); }, CFG.autoWalkOpen*1000);
}

const doorBtn=document.getElementById('doorBtn');
let btnDoor=null;
function updateDoorBtn(){ const d=nearDoor(); btnDoor=d;
  doorBtn.style.display=(d&&!d.open&&!transitioning)?'block':'none'; }

// ── interaction hotspots (evidence book, cctv monitor) ──
const actBtn=document.getElementById('actBtn');
function nearSpot(){ const s=scene(); if(!s.spots) return null;
  let best=null,bd=1e9;
  for(const sp of s.spots){
    let dist;
    if(sp.x0!==undefined){
      // Distance from the detective's feet to the nearest edge of a rectangular
      // interaction area. This lets large objects be accessed from every side.
      const nx=clamp(P.x,sp.x0,sp.x1), ny=clamp(P.y,sp.y0,sp.y1);
      dist=Math.hypot(P.x-nx,P.y-ny);
      if(P.x>=sp.x0&&P.x<=sp.x1&&P.y>=sp.y0&&P.y<=sp.y1) dist=0;
      if(dist<(sp.reach||70)&&dist<bd){ bd=dist; best=sp; }
    } else {
      dist=Math.hypot(P.x-sp.tx,P.y-sp.ty);
      if(dist<sp.r&&dist<bd){ bd=dist; best=sp; }
    }
  }
  return best;
}
function updateActBtn(){ const sp=transitioning?null:nearSpot();
  if(sp){ actBtn.textContent=sp.label+' (E)'; actBtn.style.display='block'; }
  else actBtn.style.display='none';
}
actBtn.addEventListener('click',()=>{ const sp=nearSpot();
  if(sp&&!transitioning) sp.act(); actBtn.blur(); });

// per-frame door bookkeeping: doors opened by walking INTO the hall (the room you
// just left) auto-close after doorHold. Doors are only ever traversed via E now.
function updateDoors(dt){ const s=scene();
  for(const d of s.doors){ if(!d.open||d.pending) continue;
    if(d.hold>0){ d.hold-=dt;
      if(d.hold<=0){ d.open=false; if(s.openDoor===d) s.openDoor=null; updateDoorBtn(); } }
  }
}
function doTransition(d){ if(transitioning) return; transitioning=true;
  const fade=document.getElementById('fade'); fade.style.opacity='1';
  doorBtn.style.display='none'; actBtn.style.display='none';
  const from=cur;
  setTimeout(()=>{ enterScene(d.target,d.spawn,from);
    setTimeout(()=>{ fade.style.opacity='0'; transitioning=false; },40);
  },190);
}

// ── input ──
function onKD(e){
  if(e.target&&['INPUT','TEXTAREA'].includes(e.target.tagName)) return;
  if(e.code==='Escape'){ if(invPopOpen()) leaveInvestigation(); else closeAllPops(); return; }
  if(popOpen()){ if(e.code==='KeyE'&&invPopOpen()) leaveInvestigation(); return; }
  keys.add(e.code);
  if(e.code==='KeyE'){
    if(nearDoor()) openCurrentDoor();
    else { const sp=nearSpot(); if(sp&&!transitioning) sp.act(); }
  }
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key)) e.preventDefault(); }
function onKU(e){ keys.delete(e.code); }
document.querySelectorAll('.dpad button[data-d]').forEach(b=>{ const d=b.dataset.d;
  b.addEventListener('pointerdown',e=>{e.preventDefault();vkeys.add(d);});
  b.addEventListener('pointerup',()=>vkeys.delete(d));
  b.addEventListener('pointerleave',()=>vkeys.delete(d)); });
doorBtn.addEventListener('click',()=>{ openCurrentDoor(); doorBtn.blur(); });

function update(dt){
  clock+=dt;
  if(transitioning||popOpen()){ P.moving=false; return; }
  let dx=0,dy=0;
  if(keys.has('ArrowLeft')||keys.has('KeyA')||vkeys.has('left')) {dx=-1;P.dir='left';}
  if(keys.has('ArrowRight')||keys.has('KeyD')||vkeys.has('right')){dx=1;P.dir='right';}
  if(keys.has('ArrowUp')||keys.has('KeyW')||vkeys.has('up'))    {dy=-1;P.dir='up';}
  if(keys.has('ArrowDown')||keys.has('KeyS')||vkeys.has('down')){dy=1;P.dir='down';}
  if(dx&&dy){dx*=0.7071;dy*=0.7071;}
  P.moving=dx!==0||dy!==0;
  const s=scene();
  if(P.moving){
    const step=CFG.speed*dt*60;   // frame-rate independent movement
    const nx=P.x+dx*step; if(!collides(s,nx,P.y)) P.x=nx;
    const ny=P.y+dy*step; if(!collides(s,P.x,ny)) P.y=ny;
    P.ftick+=dt; if(P.ftick>=1/CFG.animFps){ P.ftick-=1/CFG.animFps; P.frame++; }
  } else { P.frame=0; P.ftick=0; }
  updateDoorBtn();
  updateActBtn();
  updateDoors(dt);
}

function pickSprite(){
  const {dir,moving,frame}=P;
  if(moving){
    if(dir==='down')  return SPR.walk.down[frame%SPR.walk.down.length];
    if(dir==='left')  return SPR.walk.left[frame%SPR.walk.left.length];
    if(dir==='right') return SPR.walk.right[frame%SPR.walk.right.length];
    return SPR.walk.up[frame%SPR.walk.up.length];   // north walk sheet
  }
  return SPR.idle[dir]||SPR.idle.down;
}

function drawPlayer(){
  const s=scene(), t=clamp((P.y-s.floorTop)/(s.floorBot-s.floorTop),0,1);
  const ds=0.80+0.42*t, img=pickSprite();
  ctx.save(); ctx.globalAlpha=.28; ctx.fillStyle='#000';
  ctx.beginPath(); ctx.ellipse(P.x,P.y+3,30*ds,9*ds,0,0,Math.PI*2); ctx.fill(); ctx.restore();
  const Hh=150*ds, sc=Hh/img.height, dw=img.width*sc, dyy=Math.round(P.y-Hh);
  ctx.imageSmoothingEnabled=true;
  ctx.drawImage(img,Math.round(P.x-dw/2),dyy,dw,Hh);
}

function render(){
  const s=scene();
  let bg=s.bgClosed;
  if(s.openDoor){ if(cur==='hall'){ if(s.openDoor.openImg) bg=s.openDoor.openImg; }
                  else bg=s.bgOpen; }
  ctx.drawImage(bg,0,0,W,H);
  drawPlayer();
  // depth occlusion: only when the player's feet are truly BEHIND the object's
  // floor footprint (above its back edge) — never when standing beside/in front
  // of it, which used to slice the sprite in half.
  for(const o of s.obstacles){
    if(P.y<o.y0 && P.x>o.x0-70 && P.x<o.x1+70){
      const vy=(o.vy0!==undefined?o.vy0:Math.max(0,o.y0-90));
      const ox=Math.max(0,o.x0-8), ow=Math.min(W,o.x1+8)-ox, oh=o.y1-vy+4;
      ctx.drawImage(bg,ox,vy,ow,oh, ox,vy,ow,oh);
    }
  }
  if(DEBUG) drawDebug(s);
}
function drawDebug(s){
  ctx.save(); ctx.lineWidth=2;
  ctx.strokeStyle='rgba(0,255,120,.9)';
  ctx.beginPath();
  ctx.moveTo(edgeL(s,s.floorTop),s.floorTop); ctx.lineTo(edgeR(s,s.floorTop),s.floorTop);
  ctx.lineTo(edgeR(s,s.floorBot),s.floorBot); ctx.lineTo(edgeL(s,s.floorBot),s.floorBot);
  ctx.closePath(); ctx.stroke();
  ctx.strokeStyle='rgba(255,80,80,.9)';
  for(const o of s.obstacles) ctx.strokeRect(o.x0,o.y0,o.x1-o.x0,o.y1-o.y0);
  ctx.fillStyle='rgba(80,160,255,.9)';
  for(const d of s.doors){ ctx.beginPath(); ctx.arc(d.tx,d.ty,6,0,Math.PI*2); ctx.fill(); }
  ctx.fillStyle='#ff0'; ctx.fillRect(P.x-2,P.y-2,4,4);
  ctx.restore();
}

let last=0;
function loop(ts){ const dt=Math.min((ts-last)/1000,0.05); last=ts;
  update(dt); render(); raf=requestAnimationFrame(loop); }


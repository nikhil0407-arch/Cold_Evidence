<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/png" sizes="64x64" href="images/favicon.png">
<title>The Last Toast</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html,body { background:#0c0d10; height:100%; }
body { color:#e7e7e7; font-family:'Fixedsys Excelsior',monospace;
  display:flex; align-items:center; justify-content:center; overflow:hidden; }

#loader { text-align:center; }
#loader h1 { font-size:28px; letter-spacing:8px; color:#c8a04a; margin-bottom:14px; }
#loader .bar { width:280px; height:8px; background:#1c1c22; border:1px solid #333; margin:0 auto; }
#loader .fill { height:100%; width:0; background:#c8a04a; transition:width .15s; }
#loader p { font-size:15px; color:#666; letter-spacing:2px; margin-top:12px; }

#gameWrap { position:relative; display:none; box-shadow:0 0 60px rgba(0,0,0,.8); }
#game { display:block; image-rendering:auto; background:#000; }

#hud { position:absolute; top:12px; left:16px; font-size:15px; color:#9aa0ab;
  letter-spacing:1px; pointer-events:none; text-shadow:0 1px 3px #000; }
#sceneLbl { position:absolute; top:12px; left:50%; transform:translateX(-50%);
  font-size:15px; letter-spacing:4px; color:#c8a04a; text-shadow:6px 6px 10px #000; pointer-events:none; }

.iconbar { position:absolute; top:10px; right:12px; display:flex; gap:8px; }
.iconbar button { width:40px; height:40px; font-size:21px; cursor:pointer;
  background:rgba(20,22,28,.85); border:1px solid #444; color:#d8d8d8; border-radius:6px;
  display:flex; align-items:center; justify-content:center; transition:.15s; }
.iconbar button:hover { background:#c8a04a; color:#111; border-color:#e7c87e; }

.actionbtn { display:none; position:absolute; left:50%; bottom:26px; transform:translateX(-50%);
  padding:11px 20px; background:#c8a04a; border:1px solid #e7c87e; color:#161616;
  font-family:'Fixedsys Excelsior',monospace; font-size:13px; font-weight:bold; letter-spacing:2px;
  cursor:pointer; border-radius:5px; box-shadow:0 0 20px rgba(200,160,74,.6);
  animation:pulse 1.1s ease-in-out infinite; }
.actionbtn:hover { background:#e2ba62; }
@keyframes pulse { 0%,100%{transform:translateX(-50%) scale(1)} 50%{transform:translateX(-50%) scale(1.06)} }

.popup { display:none; position:absolute; inset:0; background:rgba(6,7,10,.82);
  align-items:center; justify-content:center; z-index:20; }
.popup.on { display:flex; }
.popup .frame { position:relative; max-width:94%; max-height:92%; }
.popup img { max-width:100%; max-height:82vh; display:block; border:2px solid #2a2a2a; border-radius:6px; }
.popup .back { position:absolute; top:10px; left:10px; padding:7px 16px; background:#161616;
  border:1px solid #c8a04a; color:#c8a04a; font-family:'Fixedsys Excelsior',monospace; font-size:13px;
  letter-spacing:2px; cursor:pointer; border-radius:4px; }
.popup .back:hover { background:#c8a04a; color:#111; }
.popup .close { position:absolute; top:10px; right:10px; width:38px; height:38px;
  background:#161616; border:1px solid #c8a04a; color:#c8a04a; font-size:17px;
  font-family:'Fixedsys Excelsior',monospace; cursor:pointer; border-radius:4px; }
.popup .close:hover { background:#c8a04a; color:#111; }
.popup .pgbtn { position:absolute; bottom:10px; padding:7px 16px; background:#161616;
  border:1px solid #c8a04a; color:#c8a04a; font-family:'Fixedsys Excelsior',monospace; font-size:13px;
  letter-spacing:2px; cursor:pointer; border-radius:4px; }
.popup .pgbtn:hover { background:#c8a04a; color:#111; }
#bookPrev { left:10px; }
#bookNext { right:10px; }

#cctvPop { display:none; position:absolute; inset:0; background:#000; z-index:20; }
#cctvPop.on { display:block; }
#cctvPop canvas { display:block; }
#cctvPop .back { position:absolute; top:10px; left:10px; padding:7px 16px; background:#161616;
  border:1px solid #c8a04a; color:#c8a04a; font-family:'Fixedsys Excelsior',monospace; font-size:13px;
  letter-spacing:2px; cursor:pointer; border-radius:4px; z-index:2; }
#cctvPop .back:hover { background:#c8a04a; color:#111; }
/* pitch-black slot over the monitor's screen — the CCTV footage <video> mounts here later */
#cctvScreen { position:absolute; background:#000 center/contain no-repeat; z-index:1; overflow:hidden; }

/* interrogation cut-scene — sits UNDER #fade (z15) so scene fades cover it */
#invPop { display:none; position:absolute; inset:0; background:#000; z-index:14; }
#invPop.on { display:block; }
#invPop canvas { display:block; }
#invPop.on #invLeave { display:block; }

.dpad { position:absolute; bottom:20px; right:20px;
  display:grid; grid-template-columns:repeat(3,42px); grid-template-rows:repeat(3,42px); gap:4px; opacity:.85; }
.dpad button { background:rgba(20,22,28,.7); border:1px solid rgba(255,255,255,.12); color:#aab;
  font-size:18px; border-radius:6px; cursor:pointer; user-select:none;
  display:flex; align-items:center; justify-content:center; }
.dpad button:active { background:rgba(200,160,74,.55); color:#111; }
.dpad .e { background:transparent; border:none; pointer-events:none; }

#fade { position:absolute; inset:0; background:#000; opacity:0; pointer-events:none; z-index:15; transition:opacity .18s; }

/* AI interrogation controls */
#dialoguePanel{position:absolute;left:22px;right:22px;bottom:78px;z-index:3;background:rgba(7,8,11,.92);border:1px solid #c8a04a;border-radius:7px;padding:10px;box-shadow:0 0 22px rgba(0,0,0,.7)}
#dialogueLog{height:105px;overflow:auto;font-size:15px;line-height:1.45;padding:4px 6px;color:#ddd}
#dialogueLog .detective{color:#9ecbff;margin:4px 0}#dialogueLog .suspect{color:#f2d18a;margin:4px 0}#dialogueLog .system{color:#9aa0ab;margin:4px 0}
#questionRow{display:flex;gap:8px;margin-top:8px}#questionInput{flex:1;background:#111318;color:#eee;border:1px solid #444;padding:10px;font-family:'Fixedsys Excelsior',monospace;font-size:15px;border-radius:4px;outline:none}#questionInput:focus{border-color:#c8a04a}
#askBtn,#accuseBtn{padding:9px 14px;background:#c8a04a;color:#111;border:1px solid #e7c87e;font-weight:bold;font-family:'Fixedsys Excelsior',monospace;cursor:pointer;border-radius:4px}#askBtn:disabled{opacity:.55;cursor:not-allowed}#accuseBtn{background:#7f2525;color:#fff;border-color:#bb5656}
#endingBox{display:none;position:absolute;inset:0;z-index:40;background:#050608;align-items:center;justify-content:center;flex-direction:column;padding:20px}#endingBox.on{display:flex}#endingImage{display:block;max-width:100%;max-height:calc(100% - 76px);object-fit:contain;border:2px solid #7b6848;box-shadow:0 0 35px rgba(0,0,0,.9)}#returnLoginBtn{margin-top:16px;padding:12px 24px;background:#c8a04a;color:#111;border:1px solid #e7c87e;font:bold 13px 'Fixedsys Excelsior',monospace;letter-spacing:2px;border-radius:5px;cursor:pointer}#returnLoginBtn:hover{background:#e2ba62}#endingStatus{margin-top:8px;color:#999;font-size:13px;letter-spacing:1px}
#confirmBox{display:none;position:absolute;inset:0;z-index:41;background:rgba(5,6,8,.92);align-items:center;justify-content:center;flex-direction:column;padding:20px;text-align:center}#confirmBox.on{display:flex}#confirmBox p{color:#e7c87e;font:bold 14px 'Fixedsys Excelsior',monospace;letter-spacing:1px;max-width:420px;margin:0 0 18px}#confirmBox .row{display:flex;gap:14px}#confirmYes,#confirmNo{padding:10px 22px;font:bold 13px 'Courier New',monospace;letter-spacing:2px;border-radius:5px;cursor:pointer;border:1px solid}#confirmYes{background:#7f2525;color:#fff;border-color:#bb5656}#confirmYes:hover{background:#9c2f2f}#confirmNo{background:#c8a04a;color:#111;border-color:#e7c87e}#confirmNo:hover{background:#e2ba62}
#prologue{position:fixed;inset:0;z-index:100;background:#050608;display:none;align-items:center;justify-content:center;flex-direction:column;padding:20px}#prologue.on{display:flex}#prologueImg{max-width:92%;max-height:76%;object-fit:contain;border:2px solid #7b6848;box-shadow:0 0 35px rgba(0,0,0,.9)}#prologueNextBtn{margin-top:20px;padding:12px 28px;background:#c8a04a;color:#111;border:1px solid #e7c87e;font:bold 13px 'Fixedsys Excelsior',monospace;letter-spacing:2px;border-radius:5px;cursor:pointer}#prologueNextBtn:hover{background:#e2ba62}#prologueDots{margin-top:14px;display:flex;gap:8px}#prologueDots span{width:8px;height:8px;border-radius:50%;background:#3a3d43}#prologueDots span.active{background:#e7c87e}
</style>
</head>
<body>

<div id="loader">
  <h1>DETECTIVE</h1>
  <div class="bar"><div class="fill" id="loadFill"></div></div>
  <p id="loadTxt">LOADING ASSETS…</p>
</div>

<div id="prologue">
  <img id="prologueImg" alt="Prologue panel">
  <div id="prologueDots"></div>
  <button id="prologueNextBtn">NEXT</button>
</div>

<div id="gameWrap">
  <canvas id="game" width="960" height="600"></canvas>
  <div id="hud">WASD / ARROWS — MOVE&nbsp;·&nbsp;E — INTERACT</div>
  <div id="sceneLbl">PRISONER LOBBY</div>
  <div class="iconbar">
    <button id="mapIcon" title="Map">🗺</button>
    <button id="guideIcon" title="Guidelines">📋</button>
  </div>
  <button id="doorBtn" class="actionbtn">OPEN DOOR (E)</button>
  <button id="actBtn" class="actionbtn"></button>

  <div class="dpad">
    <div class="e"></div><button data-d="up">▲</button><div class="e"></div>
    <button data-d="left">◀</button><div class="e"></div><button data-d="right">▶</button>
    <div class="e"></div><button data-d="down">▼</button><div class="e"></div>
  </div>

  <div id="fade"></div>

  <div class="popup" id="mapPop">
    <div class="frame"><button class="back">← BACK</button><img id="mapImg" alt="map"></div>
  </div>
  <div class="popup" id="guidePop">
    <div class="frame"><button class="back">← BACK</button><img id="guideImg" alt="guidelines"></div>
  </div>

  <div class="popup" id="bookPop">
    <div class="frame">
      <img id="bookImg" alt="evidence book">
      <button class="close" id="bookClose">✕</button>
      <button class="pgbtn" id="bookPrev">← PREV</button>
      <button class="pgbtn" id="bookNext">NEXT →</button>
    </div>
  </div>

  <div id="cctvPop">
    <canvas id="cctvView" width="960" height="600"></canvas>
    <!-- pitch-black slot over the monitor screen — the CCTV footage <video> mounts here in a later dev stage -->
    <div id="cctvScreen"></div>
    <button class="back" id="cctvBack">← BACK</button>
  </div>

  <!-- interrogation cut-scene: prisoner across the table, full screen -->
  <div id="invPop">
    <canvas id="invView" width="960" height="600"></canvas>
    <div id="dialoguePanel">
      <div id="dialogueLog"><div class="system">Select a suspect and ask questions about the case.</div></div>
      <div id="questionRow"><input id="questionInput" maxlength="500" placeholder="Type Detective <%= user?.username ?? "Anon" %>'s question..."><button id="askBtn">ASK</button><button id="accuseBtn">ACCUSE</button></div>
    </div>
    <div id="endingBox" aria-live="polite">
      <img id="endingImage" alt="Accusation result">
      <button id="returnLoginBtn">RETURN TO HOME PAGE</button>
    </div>
    <div id="confirmBox" aria-live="polite">
      <p id="confirmText"></p>
      <div class="row">
        <button id="confirmYes">ACCUSE</button>
        <button id="confirmNo">CANCEL</button>
      </div>
    </div>
    <button class="actionbtn" id="invLeave">LEAVE INVESTIGATION (E)</button>
  </div>
</div>

<script>
'use strict';

const W=960, H=600;
const DIR='images/game generation/';
const FILES={
  map:'1 map_architecture.png', guide:'2 guidelines cropped.png',
  lobbyC:'3 lobby closed.png',  lobbyO:'4 lobby open.png',
  invC:'5 investigation room doors closed.png', invO:'6 investigation room doors open.png',
  cctvC:'7 cctv doors closed (2).png', cctvO:'8 cctv doors open (2).png',
  evid:'9 evidence room.png',
  evBook1:'15 evidence image.jpeg', evBook2:'16 evidence image.jpeg',
  hall1:'10 hall 1st open.png', hall2:'11 hall 2nd open.png',
  hall4:'12 hall 4th open (1).png', hall3:'13 hall 3rd open.png',
  hallC:'14 hall all closed.png',
  sprF:'front sprite.png', sprL:'left sprite.png', sprR:'right sprite.png', sprB:'backward_sprite.png',
  idF:'front.png', idB:'back.png', idL:'left.png', idR:'right.png',
  lobbyPris:'21 prisoners.jpeg',
  ivEthan:'20 ethan.jpeg',   ivVictor:'19 victor hayes.jpeg',
  ivSarah:'18 sarah.jpeg',   ivEmma:'17 emma cole.jpeg',
  cctvFootage:'22 cctv footage.png',
  accusationCorrect:'23 accusation correct.jpeg', accusationWrong:'24 accusation wrong.jpeg'
};

const EMBED={
  sprF:"data:image/png;base64,",
  sprL:"data:image/png;base64,",
  sprR:"data:image/png;base64,",
  idF:"data:image/png;base64,",
  idB:"data:image/png;base64,",
  idL:"data:image/png;base64,",
  sprB:"data:image/png;base64,",
  idR:"data:image/png;base64,"
};

const IMG={};  // key -> HTMLImageElement
function preload(cb){
  const keys=Object.keys(FILES), n=keys.length; let done=0;
  keys.forEach(k=>{
    const im=new Image();
    im.onload=im.onerror=()=>{ done++;
      document.getElementById('loadFill').style.width=(done/n*100)+'%';
      if(done===n) cb();
    };
    im.src=EMBED[k]||encodeURI(DIR+FILES[k]);
    IMG[k]=im;
  });
}

// ── sprite slicing (transparency-based frame detection) ──
function toCanvas(img){ const c=document.createElement('canvas');
  c.width=img.naturalWidth||img.width||1; c.height=img.naturalHeight||img.height||1;
  c.getContext('2d').drawImage(img,0,0); return c; }
function runs(occ,minLen){ const r=[]; let s=-1;
  for(let i=0;i<occ.length;i++){ if(occ[i]){if(s<0)s=i;} else if(s>=0){ if(i-s>=minLen)r.push([s,i-1]); s=-1; } }
  if(s>=0&&occ.length-s>=minLen) r.push([s,occ.length-1]); return r; }
function detectGrid(cv){ const w=cv.width,h=cv.height;
  const d=cv.getContext('2d').getImageData(0,0,w,h).data, on=(x,y)=>d[(y*w+x)*4+3]>16;
  const rowOcc=new Array(h).fill(false);
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){ if(on(x,y)){rowOcc[y]=true;break;} }
  const bands=runs(rowOcc,Math.max(3,Math.floor(h*0.03))), cells=[];
  for(const[y0,y1]of bands){ const colOcc=new Array(w).fill(false);
    for(let x=0;x<w;x++)for(let y=y0;y<=y1;y++){ if(on(x,y)){colOcc[x]=true;break;} }
    for(const[x0,x1]of runs(colOcc,Math.max(3,Math.floor(w*0.015)))) cells.push({x0,y0,x1,y1}); }
  return cells; }
function trim(cv,x0,y0,x1,y1){ const w=x1-x0+1,h=y1-y0+1;
  const d=cv.getContext('2d').getImageData(x0,y0,w,h).data;
  let mnx=w,mny=h,mxx=0,mxy=0,f=false;
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){ if(d[(y*w+x)*4+3]>16){f=true;
    if(x<mnx)mnx=x;if(x>mxx)mxx=x;if(y<mny)mny=y;if(y>mxy)mxy=y; } }
  if(!f){mnx=0;mny=0;mxx=w-1;mxy=h-1;}
  const tw=mxx-mnx+1,th=mxy-mny+1,o=document.createElement('canvas');
  o.width=tw;o.height=th; o.getContext('2d').drawImage(cv,x0+mnx,y0+mny,tw,th,0,0,tw,th); return o; }
function sheet(key,forceCols){ const cv=toCanvas(IMG[key]);
  if(forceCols){ const cw=cv.width/forceCols, cells=[];
    for(let i=0;i<forceCols;i++) cells.push({x0:Math.round(i*cw),y0:0,x1:Math.round((i+1)*cw)-1,y1:cv.height-1});
    return cells.map(k=>trim(cv,k.x0,k.y0,k.x1,k.y1)); }
  let c=detectGrid(cv);
  if(c.length<2) c=[{x0:0,y0:0,x1:cv.width-1,y1:cv.height-1}];
  return c.map(k=>trim(cv,k.x0,k.y0,k.x1,k.y1)); }
function one(key){ const cv=toCanvas(IMG[key]); return trim(cv,0,0,cv.width-1,cv.height-1); }

// crop a source image region into a stretched W×H background canvas
function cropBg(key,sx,sy,sw,sh){ const c=document.createElement('canvas'); c.width=W;c.height=H;
  c.getContext('2d').drawImage(IMG[key],sx,sy,sw,sh,0,0,W,H); return c; }

// did this optional asset actually load? (art files 17-21 may not be saved yet)
function ok(key){ const im=IMG[key]; return !!(im&&im.naturalWidth>0); }

// cut-scene art: crop a 960:600 band out of a taller render (no squash),
// biased toward the top so the character's face stays in frame
function cine(key){ const im=IMG[key], w=im.naturalWidth, h=im.naturalHeight;
  const sh=Math.min(h,Math.round(w*H/W)), sy=Math.min(h-sh,Math.round(h*0.10));
  return cropBg(key,0,sy,w,sh); }

// ── character sprites ──
const SPR={};
function buildSprites(){
  SPR.walk={ down:sheet('sprF'), left:sheet('sprL'), right:sheet('sprR'), up:sheet('sprB') };
  SPR.idle={ down:one('idF'), up:one('idB'), left:one('idL'), right:one('idR') };
}

// pre-scale a source image to a W×H canvas ONCE (avoids re-scaling 2MP art every frame → fixes lag)
function fit(key){ const c=document.createElement('canvas'); c.width=W;c.height=H;
  c.getContext('2d').drawImage(IMG[key],0,0,W,H); return c; }

// the prisoners render bakes the four suspects in oversized next to the ~150px
// detective sprite — rebuild the lobby bg by lifting each seated figure off the
// canvas, patching the bench behind them with a clean empty-bench strip from the
// same art, and sitting them back down smaller, hips pinned to the same seat
// line. bench layout, spot centres and talk zones stay untouched.
const PRIS_SCALE=0.80;
function shrinkPrisoners(){
  const bg=fit('lobbyPris'), c=bg.getContext('2d');
  const SEAT=308;   // y of the bench seat top edge (hips pinned here)
  const WALLY=296;  // above this: bare wall behind the sitters; below: bench+floor
  // tight box per suspect; wsx = clean wall source (beside the bench ends, same
  // y-band so the wall's horizontal lines stay continuous), gap = clean bench
  // strip between two sitters (only safe below WALLY — at shoulder height the
  // gaps are body-shadowed and would tile as dark panels)
  const BOX=[
    {x0:285,x1:393,y0:214,y1:398,wsx:224,gap:490},   // ethan
    {x0:396,x1:488,y0:213,y1:397,wsx:224,gap:490},   // victor
    {x0:498,x1:573,y0:224,y1:391,wsx:688,gap:574},   // sarah
    {x0:582,x1:670,y0:219,y1:399,wsx:688,gap:574}    // emma
  ], WW=30, GW=6;
  const cuts=BOX.map(r=>{ const w=r.x1-r.x0,h=r.y1-r.y0;
    const cv=document.createElement('canvas'); cv.width=w; cv.height=h;
    cv.getContext('2d').drawImage(bg,r.x0,r.y0,w,h,0,0,w,h); return cv; });
  // Rebuild the whole wall behind the seated row as ONE continuous strip.
  // The previous per-character wall tiles created visible rectangular panels.
  // Stretching one clean same-height wall sample keeps the horizontal divider,
  // shading and brick rows continuous with no seams behind the suspects.
  const wallX0=270, wallX1=682, wallY0=205, wallY1=WALLY;
  c.drawImage(bg,210,wallY0,70,wallY1-wallY0,
                wallX0,wallY0,wallX1-wallX0,wallY1-wallY0);

  // Rebuild only the bench/floor area beneath each removed full-size suspect.
  // Narrow repeated strips are hidden by the bench texture and the resized
  // characters, while the visible wall above now remains completely smooth.
  for(const r of BOX){
    for(let x=r.x0;x<r.x1;x+=GW){ const w=Math.min(GW,r.x1-x);
      c.drawImage(bg,r.gap,WALLY,w,r.y1-WALLY, x,WALLY,w,r.y1-WALLY); }
  }
  c.imageSmoothingEnabled=true;
  BOX.forEach((r,i)=>{ const w=(r.x1-r.x0)*PRIS_SCALE, h=(r.y1-r.y0)*PRIS_SCALE;
    c.drawImage(cuts[i],(r.x0+r.x1)/2-w/2, SEAT-(SEAT-r.y0)*PRIS_SCALE, w,h); });
  return bg;
}

// ════ SCENES ════
let EVID_O, EVID_C;
const SCENES={};

// the four suspects held in the lobby; img = their interrogation cut-scene art
const PRISONERS={
  ethan :{ name:'ETHAN BROOKS',  img:'ivEthan'  },
  victor:{ name:'VICTOR HAYES',  img:'ivVictor' },
  sarah :{ name:'SARAH MILES',   img:'ivSarah'  },
  emma  :{ name:'EMMA COLE',     img:'ivEmma'   },
};
const IVIEW={};   // prisoner key -> pre-cropped 960×600 cut-scene canvas (or null)

function buildScenes(){
  // evidence art is a 2-panel sheet (top=open, bottom=closed) with corner labels; crop inside them
  const eh=IMG.evid.height, ew=IMG.evid.width, ex=Math.round(ew*0.145);
  EVID_O=cropBg('evid',ex,Math.round(eh*0.03),ew-ex-Math.round(ew*0.01),Math.round(eh*0.45));
  EVID_C=cropBg('evid',ex,Math.round(eh*0.525),ew-ex-Math.round(ew*0.01),Math.round(eh*0.45));

  for(const k in PRISONERS) IVIEW[k]=ok(PRISONERS[k].img)?cine(PRISONERS[k].img):null;

  // when the prisoners render exists it becomes the lobby's only background
  // (prisoners stay seated even while a door swings — we have no open-door
  //  variant of that art), with collision boxes for the bench row + officers
  const hasPris=ok('lobbyPris');
  const prisBg=hasPris?fit('lobbyPris'):null;   // use the original prisoners asset at its native composition; do not resize suspects
  SCENES.lobby={ label:'PRISONER LOBBY',
    bgClosed:prisBg||fit('lobbyC'),
    bgOpen:  prisBg||fit('lobbyO'),
    floorTop:292, floorBot:560, backL:170, backR:790, frontL:60, frontR:900,
    obstacles:hasPris

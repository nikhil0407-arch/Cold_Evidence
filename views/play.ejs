// ── backend-powered interrogation ──
const API_BASE='/api';
async function initBackendSession(){
  if(gameSessionId) return gameSessionId;
  try{const r=await fetch(API_BASE+'/session/start',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const d=await r.json();gameSessionId=d.sessionId;localStorage.setItem('lastToastSession',gameSessionId);return gameSessionId;}catch(e){return null;}
}
function resetDialogueUI(){const log=document.getElementById('dialogueLog');if(log)log.innerHTML='<div class="system">Interrogating '+(PRISONERS[currentSuspectId]?.name||'suspect')+'. Ask about alibis, motives and evidence.</div>';}
function addDialogue(kind,text){const log=document.getElementById('dialogueLog');const d=document.createElement('div');d.className=kind;d.textContent=(kind==='detective'?'DETECTIVE: ':kind==='suspect'?(PRISONERS[currentSuspectId]?.name.toUpperCase()+': '):'')+text;log.appendChild(d);log.scrollTop=log.scrollHeight;}
function startDialogue(kind,prefixText){const log=document.getElementById('dialogueLog');const d=document.createElement('div');d.className=kind;d.textContent=prefixText;log.appendChild(d);log.scrollTop=log.scrollHeight;return d;}

// Reveals text at a fixed pace regardless of how large each network chunk is,
// so a coarse Gemini chunk (a full clause/sentence at once) still looks like
// a smooth typewriter instead of jumping in big blocks.
function createTypewriter(el,minChars=1,maxChars=4,minTickMs=20,maxTickMs=90){
	let queue='';
	let timer=null;
	let resolveDrain=null;
	function randInt(min,max){return min+Math.floor(Math.random()*(max-min+1));}
	function tick(){
		if(!queue){
			timer=null;
			if(resolveDrain){const r=resolveDrain;resolveDrain=null;r();}
			return;
		}
		const take=queue.slice(0,randInt(minChars,maxChars));
		queue=queue.slice(take.length);
		el.textContent+=take;
		document.getElementById('dialogueLog').scrollTop=document.getElementById('dialogueLog').scrollHeight;
		timer=setTimeout(tick,randInt(minTickMs,maxTickMs));
	}
	return {
		push(text){queue+=text;if(!timer)tick();},
		// resolves once the queue has actually finished draining at the configured pace — use this instead of flush() on a normal successful finish
		whenDrained(){
			if(!queue&&!timer)return Promise.resolve();
			return new Promise(res=>{resolveDrain=res;});
		},
		// drains whatever's left instantly — reserved for error bail-outs, not normal completion
		flush(){if(timer){clearTimeout(timer);timer=null;}el.textContent+=queue;queue='';document.getElementById('dialogueLog').scrollTop=document.getElementById('dialogueLog').scrollHeight;if(resolveDrain){const r=resolveDrain;resolveDrain=null;r();}}
	};
}

async function askSuspect(){
	if(askPending||!currentSuspectId)return;
	const input=document.getElementById('questionInput');
	const q=input.value.trim();
	if(!q)return;
	askPending=true;
	document.getElementById('askBtn').disabled=true;
	addDialogue('detective',q);
	input.value='';
	addDialogue('system','Thinking...');
	const thinking=document.getElementById('dialogueLog').lastChild;
	let suspectEl=null;
	let doneEvent=null;
	let typewriter=null;
	try{
		await initBackendSession();
		const r=await fetch(API_BASE+'/interrogate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sessionId:gameSessionId,suspectId:currentSuspectId,question:q})});
		if(!r.ok){
			const errBody=await r.json().catch(()=>({}));
			throw new Error(errBody.error||'Request failed');
		}
		thinking.remove();

		const namePrefix=(PRISONERS[currentSuspectId]?.name.toUpperCase()+': ');
		suspectEl=startDialogue('suspect',namePrefix);
		typewriter=createTypewriter(suspectEl);

		const reader=r.body.getReader();
		const decoder=new TextDecoder();
		let buffer='';

		while(true){
			const {value,done:streamDone}=await reader.read();
			if(streamDone)break;
			buffer+=decoder.decode(value,{stream:true});
			let newlineIndex;
			while((newlineIndex=buffer.indexOf('\n'))!==-1){
				const line=buffer.slice(0,newlineIndex);
				buffer=buffer.slice(newlineIndex+1);
				if(!line.trim())continue;
				const event=JSON.parse(line);
				if(event.type==='chunk'){
					typewriter.push(event.text);
				}else if(event.type==='done'){
					doneEvent=event;
				}else if(event.type==='error'){
					typewriter.flush();
					throw new Error(event.error||'Stream error');
				}
			}
		}

		await typewriter.whenDrained();
		console.log('Interrogation response source:',doneEvent?.source,doneEvent);
		if(doneEvent?.source&&doneEvent.source!=='gemini')addDialogue('system','AI status: '+doneEvent.source+(doneEvent.debugError?' — '+doneEvent.debugError:''));
		if(doneEvent?.clueUnlocked)addDialogue('system','New evidence recorded: '+doneEvent.clueUnlocked.replaceAll('_',' ').toUpperCase());
	}catch(e){
		if(thinking&&thinking.parentNode)thinking.remove();
		if(typewriter)typewriter.flush();
		if(suspectEl&&!suspectEl.textContent.replace(PRISONERS[currentSuspectId]?.name.toUpperCase()+': ','').trim())suspectEl.remove();
		console.error('Interrogation request failed:',e);
		addDialogue('system','AI request failed: '+e.message+'. Check the backend CMD window.');
	}finally{
		askPending=false;
		document.getElementById('askBtn').disabled=false;
		input.focus();
	}
}
let accusationPending=false;

// Promise-based replacement for window.confirm() using the #confirmBox overlay.
function askConfirm(message){
	return new Promise(resolve=>{
		const box=document.getElementById('confirmBox');
		document.getElementById('confirmText').textContent=message;
		const yesBtn=document.getElementById('confirmYes');
		const noBtn=document.getElementById('confirmNo');
		function cleanup(result){
			box.classList.remove('on');
			yesBtn.removeEventListener('click',onYes);
			noBtn.removeEventListener('click',onNo);
			resolve(result);
		}
		function onYes(){cleanup(true);}
		function onNo(){cleanup(false);}
		yesBtn.addEventListener('click',onYes);
		noBtn.addEventListener('click',onNo);
		box.classList.add('on');
	});
}

async function accuseCurrent(){
  if(accusationPending||!currentSuspectId)return;
  const confirmed=await askConfirm('Accuse '+PRISONERS[currentSuspectId].name+' of murdering Adrian Cole?');
  if(!confirmed)return;
  accusationPending=true;
  const suspectId=currentSuspectId;
  const suspectName=PRISONERS[suspectId].name;
  const accuseBtn=document.getElementById('accuseBtn');
  const askBtn=document.getElementById('askBtn');
  const input=document.getElementById('questionInput');
  accuseBtn.disabled=true; askBtn.disabled=true; input.disabled=true;
  addDialogue('detective','I have reviewed the statements and evidence. '+suspectName+', I am accusing you of murdering Adrian Cole.');
  addDialogue('system','Submitting final accusation...');
  try{
    await initBackendSession();
    const r=await fetch(API_BASE+'/accuse',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sessionId:gameSessionId,suspectId})});
    const d=await r.json();
    if(!r.ok)throw new Error(d.error||'Accusation failed');
    const correct=d.ending&&d.ending.type==='true';
    setTimeout(()=>{
      const resultImg=document.getElementById('endingImage');
      resultImg.src=(correct?IMG.accusationCorrect:IMG.accusationWrong).src;
      resultImg.alt=correct?'Accusation correct — case closed':'Accusation wrong — case failed';
      document.getElementById('endingBox').classList.add('on');
    },2500);
  }catch(e){
    addDialogue('system','The accusation system is temporarily unavailable: '+e.message);
    accusationPending=false; accuseBtn.disabled=false; askBtn.disabled=false; input.disabled=false;
  }
}
document.getElementById('askBtn').addEventListener('click',askSuspect);
document.getElementById('questionInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();askSuspect();e.stopPropagation();}});
document.getElementById('accuseBtn').addEventListener('click',accuseCurrent);
document.getElementById('returnLoginBtn').addEventListener('click',()=>{ window.location.href='/'; });

function rrect(c,x,y,w,h,r){ c.beginPath(); c.moveTo(x+r,y); c.arcTo(x+w,y,x+w,y+h,r);
  c.arcTo(x+w,y+h,x,y+h,r); c.arcTo(x,y+h,x,y,r); c.arcTo(x,y,x+w,y,r); c.closePath(); }

// first-person view of the security monitor: steel-tile wall, desk, black
// "ELITE" monitor with a dead screen, keyboard — drawn once, on first open
function drawCCTVView(){
  const c=document.getElementById('cctvView').getContext('2d');
  const wg=c.createRadialGradient(480,260,140,480,300,720);
  wg.addColorStop(0,'#484b51'); wg.addColorStop(1,'#1a1c20');
  c.fillStyle=wg; c.fillRect(0,0,W,H);
  c.strokeStyle='rgba(0,0,0,.4)'; c.lineWidth=3;
  for(let x=240;x<W;x+=240){ c.beginPath(); c.moveTo(x,0); c.lineTo(x,462); c.stroke(); }
  for(let y=150;y<462;y+=160){ c.beginPath(); c.moveTo(0,y); c.lineTo(W,y); c.stroke(); }
  c.fillStyle='rgba(0,0,0,.5)';
  for(let x=240;x<W;x+=240) for(let y=150;y<462;y+=160)
    for(const[ox,oy]of[[-14,-14],[14,-14],[-14,14],[14,14]]){
      c.beginPath(); c.arc(x+ox,y+oy,3,0,Math.PI*2); c.fill(); }
  // desk
  const dg=c.createLinearGradient(0,462,0,H); dg.addColorStop(0,'#303338'); dg.addColorStop(1,'#101114');
  c.fillStyle=dg; c.fillRect(0,462,W,H-462);
  c.fillStyle='rgba(255,255,255,.07)'; c.fillRect(0,462,W,2);
  c.fillStyle='rgba(0,0,0,.45)';
  c.beginPath(); c.ellipse(480,486,230,14,0,0,Math.PI*2); c.fill();
  c.beginPath(); c.ellipse(480,584,240,12,0,0,Math.PI*2); c.fill();
  // stand
  c.fillStyle='#0d0e10'; c.fillRect(452,436,56,40);
  rrect(c,372,468,216,18,9); c.fillStyle='#0b0c0e'; c.fill();
  c.fillStyle='rgba(255,255,255,.06)'; c.fillRect(380,470,200,3);
  // bezel + dead screen
  rrect(c,180,58,600,398,16); c.fillStyle='#101114'; c.fill();
  c.strokeStyle='#33363c'; c.lineWidth=2; c.stroke();
  c.fillStyle='#000'; c.fillRect(CCTV_SCR.x,CCTV_SCR.y,CCTV_SCR.w,CCTV_SCR.h);
  c.fillStyle='#878b92'; c.font='bold 14px "Fixedsys Excelsior",monospace'; c.textAlign='center';
  c.fillText('E L I T E',480,448);
  c.fillStyle='#d43a28'; c.beginPath(); c.arc(756,444,3.2,0,Math.PI*2); c.fill();
  // keyboard
  c.beginPath(); c.moveTo(298,506); c.lineTo(662,506); c.lineTo(692,574); c.lineTo(268,574);
  c.closePath();
  const kg=c.createLinearGradient(0,506,0,574); kg.addColorStop(0,'#1a1b1f'); kg.addColorStop(1,'#0c0d0f');
  c.fillStyle=kg; c.fill(); c.strokeStyle='#000'; c.lineWidth=2; c.stroke();
  c.fillStyle='#292b30';
  for(let r=0;r<5;r++){ const t=r/4, y=511+r*12.2;
    const xl=lerp(305,281,t), xr=lerp(655,679,t), nk=15, kw=(xr-xl)/nk;
    for(let i=0;i<nk;i++){ rrect(c,xl+i*kw+1,y,kw-2,9,2); c.fill(); } }
  c.textAlign='left';
  const v=c.createRadialGradient(480,300,280,480,300,700);
  v.addColorStop(0,'rgba(0,0,0,0)'); v.addColorStop(1,'rgba(0,0,0,.55)');
  c.fillStyle=v; c.fillRect(0,0,W,H);
}

